---
// Một lời nhắn lớn, tự chuyển sau vài giây; bấm vào dải tên để chọn lời nhắn khác.
import ReviewFan from './ReviewFan.astro';
import { loadReviews } from '../reviews';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const reviews = await loadReviews();
---
<div class:list={['grid lg:items-center', compact ? 'gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-12' : 'gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16']}>
  <div data-rotator>
    <svg class:list={['text-gold', compact ? 'size-10' : 'size-14']} viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><path d="M8 34c0-9 4-17 13-21l2 4c-5 3-7 7-7 11h7v12H8v-6zm19 0c0-9 4-17 13-21l2 4c-5 3-7 7-7 11h7v12H27v-6z" /></svg>
    <div class:list={['grid', compact ? 'mt-4' : 'mt-6']}>
      {reviews.map((r, i) => (
        <figure data-slide aria-hidden={i === 0 ? undefined : 'true'}
          class:list={['col-start-1 row-start-1 transition duration-700 ease-out', i === 0 ? 'on' : 'pointer-events-none translate-y-3 opacity-0']}>
          <blockquote class:list={['font-bold text-heading', compact ? 'text-xl leading-snug sm:text-2xl sm:leading-[1.35]' : 'text-2xl leading-snug sm:text-[2rem] sm:leading-[1.3]']}>“{r.quote}”</blockquote>
          <figcaption class:list={['flex items-center gap-3', compact ? 'mt-5' : 'mt-7']}>
            <span class="grid size-11 place-items-center rounded-full bg-azure text-base font-extrabold text-white" aria-hidden="true">{r.initial}</span>
            <span class="font-bold text-glow">{r.author}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class:list={['flex flex-wrap gap-2', compact ? 'mt-7' : 'mt-9']}>
      {reviews.map((r, i) => (
        <button type="button" data-go={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={`Xem lời nhắn ${i + 1}: ${r.author}`}
          class="h-2.5 w-7 rounded-full bg-white/20 transition-all duration-300 hover:bg-white/40 aria-[current=true]:w-12 aria-[current=true]:bg-gold"></button>
      ))}
    </div>
  </div>
  <ReviewFan reviews={reviews} compact={compact} />
</div>
