---
import { ctaHref, ctaExternal } from '../lib';

interface Props { title?: string; text?: string; }
const { title = 'Chưa biết bắt đầu từ đâu?', text = 'Nhắn Zalo cho Evad English, cho mình biết mục tiêu và ngân sách, bên mình sẽ gợi ý khóa phù hợp.' } = Astro.props;
---
<section class="wrap pb-16 sm:pb-24">
  <div class="relative overflow-hidden rounded-[2rem] flow-bg bg-[linear-gradient(110deg,#0f4bb8,#3b82f6,#0f4bb8)] px-6 py-12 text-white sm:px-12 sm:py-16">
    <div class="pointer-events-none absolute -right-16 -top-16 size-64 rounded-full bg-sky/25 blur-2xl" aria-hidden="true"></div>
    <div class="relative flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-lg">
        <h2 class="!text-white text-3xl sm:text-4xl">{title}</h2>
        <p class="mt-3 text-lg text-white/85">{text}</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={ctaHref} target={ctaExternal ? '_blank' : undefined} rel={ctaExternal ? 'noopener' : undefined} class="btn btn-cta" data-magnetic>Nhắn Zalo đăng ký</a>
        <a href="/tim-khoa-hoc" class="btn bg-white/10 text-white ring-2 ring-white/40 hover:bg-white/20">Tìm khóa theo ngân sách</a>
      </div>
    </div>
  </div>
</section>
