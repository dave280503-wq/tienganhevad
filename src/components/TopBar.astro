---
import { ctaHref, ctaExternal } from '../lib';
---
<div class="bg-deep px-4 py-2 text-center text-sm text-white/85">
  Chưa biết chọn khóa nào?
  <a href={ctaHref} target={ctaExternal ? '_blank' : undefined} rel={ctaExternal ? 'noopener' : undefined}
    class="ml-1 font-bold text-gold underline underline-offset-4 hover:text-white">Nhắn Zalo để được tư vấn</a>
</div>
