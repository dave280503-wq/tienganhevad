---
import { ctaHref, ctaExternal } from '../lib';
---
<div class="fixed inset-x-0 bottom-0 z-30 bg-surface/95 p-3 shadow-[0_-8px_24px_-12px_rgb(3_51_122/0.3)] backdrop-blur md:hidden">
  <a href={ctaHref} target={ctaExternal ? '_blank' : undefined} rel={ctaExternal ? 'noopener' : undefined}
    class="btn btn-cta w-full">Nhắn Zalo để đăng ký</a>
</div>
