---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../content/site.json';
import PageHero from '../components/PageHero.astro';
import cover from '../assets/founder/duy-work.jpg';

// Thả ảnh QR vào src/assets/zalo-qr.png (hoặc .jpg) là hiện ra, không cần sửa code.
const qrs = import.meta.glob<{ default: ImageMetadata }>('../assets/zalo-qr.{png,jpg,jpeg,webp}', { eager: true });
const qr = Object.values(qrs)[0]?.default;
---
<Base title="Đăng ký qua Zalo" description="Nhắn Zalo cho Evad English để đăng ký học.">
  <PageHero title="Đăng ký qua Zalo" lead="Quét mã QR bằng Zalo rồi nhắn khóa bạn quan tâm." cover={cover} coverPosition="70% 40%" />
  <div class="sheet theme-light min-h-[22rem]">
    <div class="wrap section">
      {qr ? (
        <div class="grid items-center gap-10 md:grid-cols-[auto_1fr] md:gap-14">
          <Image src={qr} alt="Mã QR Zalo của Evad English" width={600} class="h-auto w-72 rounded-[2rem] shadow-lift sm:w-80" />
          <ol class="grid max-w-md gap-5">
            {['Mở Zalo, chọn biểu tượng quét mã QR', 'Quét mã bên cạnh và bấm Kết bạn', 'Nhắn khóa học bạn quan tâm, bên mình sẽ tư vấn'].map((s, i) => (
              <li class="flex items-start gap-4 text-lg font-semibold text-heading">
                <span class="grid size-9 shrink-0 place-items-center rounded-full bg-azure text-sm font-extrabold text-white">{i + 1}</span>
                <span class="pt-1">{s}</span>
              </li>
            ))}
          </ol>
        </div>
      ) : (
        <p class="placeholder max-w-md">[Đang cập nhật] Mã QR Zalo sẽ hiện ở đây.</p>
      )}
      {site.zaloUrl && <a href={site.zaloUrl} class="btn btn-cta mt-6" target="_blank" rel="noopener">Mở Zalo</a>}
    </div>
  </div>
</Base>
